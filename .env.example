# Epidemic Agent Environment Variables
# Copy to .env and fill in values

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=your_gemini_api_key_here

# Persistence Security (REQUIRED for trusted pickle)
PICKLE_HMAC_KEY=generate_with_openssl_rand_hex_32

# Data Sources
COVID19INDIA_API=https://api.covid19india.org
COWIN_API=https://cdn-api.co-vin.in/api

# Simulation Defaults
DEFAULT_POPULATION=1000000
DEFAULT_SIMULATION_DAYS=90