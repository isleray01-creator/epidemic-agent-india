# EpiPulse Frontend Environment Variables
# Set VITE_API_URL to your deployed Python backend URL
# Leave empty or unset for client-side simulation fallback

# Local development (FastAPI on port 8000)
VITE_API_URL=http://localhost:8000

# Production (deploy your backend separately, e.g., on Railway/Render)
# VITE_API_URL=https://your-backend-url.vercel.app
